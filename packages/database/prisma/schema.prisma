model BriefingEvent {
  id                 String                      @id
  watcherBot         BriefingWatcherBot
  externalEventId    String?
  occurredAt         DateTime?
  publishedAt        DateTime?
  detectedAt         DateTime
  createdAt          DateTime
  updatedAt          DateTime
  category           String
  subcategory        String?
  title              String
  summary            String
  importance         Int
  novelty            Int
  relevance          Int
  urgency            Int
  actionable         Boolean
  action             String?
  entities           Json
  tags               String[]
  sourceUrls         String[]
  primarySource      String?
  confidence         BriefingConfidence
  status             BriefingEventStatus
  deduplicationKey   String?
  relatedEventIds    String[]                    @default([])
  metadata           Json?
  embedding          Unsupported("vector")?
  embeddingModel     String?
  embeddingInputHash String?
  embeddingUpdatedAt DateTime?
  storyClusters      BriefingStoryClusterEvent[]

  @@unique([watcherBot, externalEventId])
  @@unique([watcherBot, deduplicationKey])
  @@index([watcherBot, detectedAt])
  @@index([status, detectedAt])
  @@map("briefing_events")
}

model BriefingStoryCluster {
  id           String                      @id
  title        String
  summary      String
  status       BriefingEventStatus
  importance   Int
  novelty      Int
  relevance    Int
  urgency      Int
  actionable   Boolean
  actionItems  String[]                    @default([])
  watcherBots  BriefingWatcherBot[]
  entities     Json
  sourceUrls   String[]                    @default([])
  firstEventAt DateTime
  lastEventAt  DateTime
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  events       BriefingStoryClusterEvent[]

  @@index([status, lastEventAt])
  @@map("briefing_story_clusters")
}

model BriefingStoryClusterEvent {
  clusterId String
  eventId   String               @unique
  createdAt DateTime             @default(now())
  cluster   BriefingStoryCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  event     BriefingEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([clusterId, eventId])
  @@map("briefing_story_cluster_events")
}

model BriefingSettings {
  id                     String                    @id @default(uuid())
  telegramChatId         BigInt                    @unique
  onboardingComplete     Boolean                   @default(false)
  language               String                    @default("en")
  voice                  BriefingVoice             @default(AMY)
  timezone               String                    @default("Europe/Prague")
  briefingTime           String                    @default("07:00;20:00;weekly:MON:07:00;weekly:SUN:20:00")
  targetDurationMinutes  Int                       @default(7)
  maximumDurationMinutes Int                       @default(15)
  sendTranscript         Boolean                   @default(false)
  calendarEnabled        Boolean                   @default(false)
  weatherEnabled         Boolean                   @default(true)
  priorityKeywords       String[]                  @default([])
  mutedKeywords          String[]                  @default([])
  nextBriefingAt         DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  subscriptions          BriefingSubscription[]
  location               BriefingLocation?
  onboarding             OnboardingState?
  runs                   BriefingRun[]
  storyStates            BriefingStoryState[]
  calendarIntegration    CalendarIntegrationState?
  feedback               BriefingFeedback[]
  goals                  BriefingGoal[]
  journalSessions        JournalSession[]

  @@index([onboardingComplete, nextBriefingAt])
  @@map("briefing_settings")
}

model JournalSession {
  id                   String            @id @default(uuid())
  settingsId           String
  telegramUserId       BigInt
  journalDate          String            @db.VarChar(10)
  mode                 JournalMode?
  status               JournalStatus     @default(REMINDER_PENDING)
  currentQuestion      Int               @default(0)
  answers              Json              @default("{}")
  transcript           String?
  draft                Json?
  reminderAt           DateTime
  reminderSentAt       DateTime?
  reminderLeaseUntil   DateTime?
  confirmationRequired Boolean           @default(true)
  syncStatus           JournalSyncStatus @default(NOT_READY)
  syncAttempts         Int               @default(0)
  syncNextAttemptAt    DateTime?
  syncError            String?
  notionPageId         String?
  notionPageUrl        String?
  syncedAnswers        Json?
  completedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  settings             BriefingSettings  @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, telegramUserId, journalDate])
  @@index([status, reminderAt])
  @@index([syncStatus, syncNextAttemptAt])
  @@map("journal_sessions")
}

model BriefingSubscription {
  id         String             @id @default(uuid())
  settingsId String
  watcherBot BriefingWatcherBot
  enabled    Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  settings   BriefingSettings   @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, watcherBot])
  @@index([settingsId, enabled])
  @@map("briefing_subscriptions")
}

model BriefingGoal {
  id         Int              @id @default(autoincrement())
  settingsId String
  title      String           @db.VarChar(160)
  dueOn      DateTime         @db.Date
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  settings   BriefingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, dueOn, id])
  @@map("briefing_goals")
}

model BriefingLocation {
  id         String               @id @default(uuid())
  settingsId String               @unique
  mode       BriefingLocationMode
  city       String?
  country    String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  settings   BriefingSettings     @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@map("briefing_locations")
}

model OnboardingState {
  id          String                 @id @default(uuid())
  settingsId  String                 @unique
  completed   Boolean                @default(false)
  currentStep BriefingOnboardingStep @default(LOCATION)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  settings    BriefingSettings       @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@map("onboarding_state")
}

model BriefingRun {
  id                         String                    @id @default(uuid())
  settingsId                 String
  idempotencyKey             String                    @unique
  type                       BriefingRunType
  scheduledFor               DateTime?
  startedAt                  DateTime                  @default(now())
  completedAt                DateTime?
  periodStart                DateTime
  periodEnd                  DateTime
  subscriptions              BriefingWatcherBot[]
  location                   Json?
  weatherAvailable           Boolean                   @default(false)
  calendarAvailable          Boolean                   @default(false)
  status                     BriefingRunStatus         @default(RUNNING)
  selectedStoryIds           String[]                  @default([])
  displayScript              String?
  ttsScript                  String?
  wordCount                  Int?
  targetDurationSeconds      Int
  maximumDurationSeconds     Int
  actualAudioDurationSeconds Float?
  voice                      BriefingVoice?
  telegramMessageId          String?
  failureReason              String?
  briefingDataCoverage       Int?
  metrics                    Json?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  settings                   BriefingSettings          @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  lastForStoryStates         BriefingStoryState[]      @relation("LastBriefingRun")
  deliveryAttempts           BriefingDeliveryAttempt[]
  feedback                   BriefingFeedback?

  @@index([settingsId, type, status, startedAt])
  @@index([settingsId, periodEnd])
  @@map("briefing_runs")
}

model BriefingFeedback {
  id         String                 @id @default(uuid())
  settingsId String
  runId      String                 @unique
  rating     BriefingFeedbackRating
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  settings   BriefingSettings       @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  run        BriefingRun            @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([settingsId, createdAt])
  @@map("briefing_feedback")
}

model BriefingWatcherHealth {
  watcherBot              BriefingWatcherBot          @id
  status                  BriefingWatcherHealthStatus
  lastRunAt               DateTime
  lastSuccessAt           DateTime?
  lastFailureAt           DateTime?
  lastError               String?
  eventsEmitted           Int                         @default(0)
  failedEventPublications Int                         @default(0)
  sourceFailures          Int                         @default(0)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@index([status, lastRunAt])
  @@map("briefing_watcher_health")
}

model BriefingDeliveryAttempt {
  id                String                  @id @default(uuid())
  runId             String
  channel           BriefingDeliveryChannel
  attempt           Int
  status            BriefingDeliveryStatus  @default(RUNNING)
  telegramMessageId String?
  failureReason     String?
  startedAt         DateTime                @default(now())
  completedAt       DateTime?
  run               BriefingRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, channel, attempt])
  @@index([runId, channel, status])
  @@map("briefing_delivery_attempts")
}

model TelegramOutboxMessage {
  id                String               @id @default(uuid())
  kind              String
  deduplicationKey  String
  telegramChatId    BigInt
  body              String
  status            TelegramOutboxStatus @default(PENDING)
  attemptCount      Int                  @default(0)
  nextAttemptAt     DateTime             @default(now())
  leaseToken        String?
  leaseExpiresAt    DateTime?
  telegramMessageId String?
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([kind, deduplicationKey])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@map("telegram_outbox_messages")
}

model Trading212Schedule {
  chatId    BigInt   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("trading212_schedules")
}

model BriefingStoryState {
  id                String              @id @default(uuid())
  settingsId        String
  storyId           String
  firstMentionedAt  DateTime
  lastMentionedAt   DateTime
  lastSummary       String
  importance        Int
  status            BriefingEventStatus
  lastBriefingRunId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  settings          BriefingSettings    @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  lastBriefingRun   BriefingRun?        @relation("LastBriefingRun", fields: [lastBriefingRunId], references: [id], onDelete: SetNull)

  @@unique([settingsId, storyId])
  @@index([settingsId, status, lastMentionedAt])
  @@map("briefing_story_states")
}

model CalendarIntegrationState {
  id                    String           @id @default(uuid())
  settingsId            String           @unique
  encryptedRefreshToken String?
  oauthStateHash        String?          @unique
  oauthStateExpiresAt   DateTime?
  calendarIds           String[]         @default(["primary"])
  connectedAt           DateTime?
  lastRefreshAt         DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  settings              BriefingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@map("calendar_integration_state")
}

model TelegramChat {
  id                      String                   @id @default(uuid())
  kind                    WatcherKind
  chatId                  BigInt
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  watcherConfig           WatcherConfig?
  stocks                  Stock[]
  queries                 PublicationQuery[]
  newsFeeds               NewsFeed[]
  newsTopics              NewsTopic[]
  newsCategoryPreferences NewsCategoryPreference[]
  paperPositions          PaperPosition[]
  portfolioRiskProfile    PortfolioRiskProfile?

  @@unique([kind, chatId])
}

model RealityUser {
  id                     String          @id @default(uuid())
  telegramChatId         BigInt          @unique
  enabled                Boolean         @default(true)
  reportSchedule         String          @default("0 8 1 * *")
  timezone               String          @default("Europe/Prague")
  nextReportAt           DateTime
  lastReportAt           DateTime?
  lastRunStatus          RunStatus?
  runInProgress          Boolean         @default(false)
  runStartedAt           DateTime?
  locations              String[]        @default(["Brno", "Ostrava", "Frýdek-Místek"])
  model                  Json            @default("{\"purchasePriceCzk\":3000000,\"floorAreaM2\":60,\"equityPercent\":30,\"termYears\":30,\"vacancyPercent\":5,\"annualMaintenancePercent\":1,\"annualInsuranceCzk\":3000,\"otherAnnualOwnerCostsCzk\":0}")
  alertGrossYieldPercent Decimal         @default(6) @db.Decimal(8, 4)
  alertDiscountPercent   Decimal         @default(15) @db.Decimal(8, 4)
  alertCashflowRate      Decimal         @default(5) @db.Decimal(8, 4)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  runs                   RealityRun[]
  reports                RealityReport[]
  alerts                 RealityAlert[]

  @@index([enabled, nextReportAt])
  @@map("reality_users")
}

model RealityRun {
  id              String         @id @default(uuid())
  userId          String
  trigger         RunTrigger
  status          RunStatus      @default(RUNNING)
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  metricsFetched  Int            @default(0)
  listingsFetched Int            @default(0)
  newListings     Int            @default(0)
  alertsSent      Int            @default(0)
  sourceFailures  Json           @default("[]")
  error           String?
  user            RealityUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report          RealityReport?

  @@index([userId, startedAt])
  @@map("reality_runs")
}

model RealityMetric {
  id          String   @id @default(uuid())
  source      String
  externalId  String
  category    String
  metric      String
  location    String?
  disposition String?
  value       Decimal  @db.Decimal(24, 8)
  unit        String
  period      DateTime
  observedAt  DateTime
  sourceUrl   String?
  raw         Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, externalId])
  @@index([metric, location, period])
  @@index([category, period])
  @@map("reality_metrics")
}

model RealityListing {
  id                       String                @id @default(uuid())
  source                   String
  externalId               String
  url                      String
  title                    String
  location                 String
  disposition              String?
  priceCzk                 Decimal               @db.Decimal(16, 2)
  floorAreaM2              Decimal               @db.Decimal(12, 2)
  estimatedMonthlyRentCzk  Decimal?              @db.Decimal(16, 2)
  annualOwnerCostsCzk      Decimal?              @db.Decimal(16, 2)
  acquisitionCostsCzk      Decimal?              @db.Decimal(16, 2)
  localMedianPricePerM2Czk Decimal?              @db.Decimal(16, 2)
  publishedAt              DateTime?
  firstSeenAt              DateTime              @default(now())
  lastSeenAt               DateTime              @default(now())
  disappearedAt            DateTime?
  raw                      Json
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  prices                   RealityListingPrice[]
  alerts                   RealityAlert[]

  @@unique([source, externalId])
  @@index([location, disappearedAt, lastSeenAt])
  @@map("reality_listings")
}

model RealityListingPrice {
  id         String         @id @default(uuid())
  listingId  String
  priceCzk   Decimal        @db.Decimal(16, 2)
  observedAt DateTime       @default(now())
  listing    RealityListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, observedAt])
  @@map("reality_listing_prices")

  project       SocialProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([contentItemId, projectId])
  @@index([projectId])
  @@map("social_content_item_projects")
}

model SocialContentItemSource {
  contentItemId String
  sourceId      String
  contentItem   SocialContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  source        SocialSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([contentItemId, sourceId])
  @@index([sourceId])
  @@map("social_content_item_sources")
}

model SocialContentRelation {
  fromContentItemId String
  toContentItemId   String
  relationType      String            @default("REPURPOSED_FROM")
  createdAt         DateTime          @default(now())
  fromContentItem   SocialContentItem @relation("SocialContentFrom", fields: [fromContentItemId], references: [id], onDelete: Cascade)
  toContentItem     SocialContentItem @relation("SocialContentTo", fields: [toContentItemId], references: [id], onDelete: Cascade)

  @@id([fromContentItemId, toContentItemId])
  @@index([toContentItemId])
  @@map("social_content_relations")
}

model SocialContentVersion {
  id            String              @id @default(uuid())
  contentItemId String
  versionNumber Int
  content       String
  source        SocialVersionSource
  createdAt     DateTime            @default(now())
  contentItem   SocialContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, versionNumber])
  @@index([contentItemId, createdAt])
  @@map("social_content_versions")
}

model SocialContentMetric {
  id                String            @id @default(uuid())
  contentItemId     String
  recordedAt        DateTime          @default(now())
  impressions       Int?
  reach             Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  clicks            Int?
  websiteVisits     Int?
  leads             Int?
  qualifiedLeads    Int?
  customersAcquired Int?
  notes             String?
  contentItem       SocialContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, recordedAt])
  @@map("social_content_metrics")
}

model SocialChecklistItem {
  id            String             @id @default(uuid())
  weeklyPlanId  String
  contentItemId String?
  title         String
  completed     Boolean            @default(false)
  completedAt   DateTime?
  sortOrder     Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  weeklyPlan    SocialWeeklyPlan   @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  contentItem   SocialContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([weeklyPlanId, sortOrder])
  @@map("social_checklist_items")
}

model SocialContentPack {
  id           String           @id @default(uuid())
  weeklyPlanId String
  version      Int
  contentHash  String
  markdown     String
  createdAt    DateTime         @default(now())
  weeklyPlan   SocialWeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@unique([weeklyPlanId, version])
  @@unique([weeklyPlanId, contentHash])
  @@map("social_content_packs")
}

model SocialExternalSync {
  id                 String           @id @default(uuid())
  ownerUserId        BigInt
  localEntityType    String
  localEntityId      String
  provider           String
  externalId         String
  lastLocalHash      String?
  lastRemoteEditedAt DateTime?
  lastSyncedAt       DateTime?
  syncStatus         SocialSyncStatus @default(PENDING)
  lastError          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([provider, externalId])
  @@unique([ownerUserId, localEntityType, localEntityId, provider])
  @@index([ownerUserId, syncStatus])
  @@map("social_external_syncs")
}

model SocialSettings {
  ownerUserId               BigInt   @id
  chatId                    BigInt
  timezone                  String   @default("Europe/Prague")
  sundayReminderTime        String   @default("09:00")
  mondayNetworkingReminder  Boolean  @default(true)
  preferredCities           String[] @default(["Brno", "Ostrava", "Frýdek-Místek"])
  travelRadiusKm            Int      @default(80)
  maximumEventPriceCzk      Int      @default(0)
  weeklyRecommendationCount Int      @default(5)
  preferredEventCategories  String[] @default(["startup", "entrepreneurship", "business", "programming", "ai", "networking"])
  enabledEventSources       String[] @default(["brno-events"])
  reminderPreferences       Json
  cadence                   Json
  pillarDistribution        Json
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([chatId])
  @@map("social_settings")
}

model SocialScheduledJob {
  id           String                @id @default(uuid())
  ownerUserId  BigInt
  chatId       BigInt
  kind         String
  scheduledFor DateTime
  status       SocialSchedulerStatus @default(PENDING)
  claimedAt    DateTime?
  completedAt  DateTime?
  lastError    String?
  payload      Json
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([ownerUserId, kind, scheduledFor])
  @@index([status, scheduledFor])
  @@map("social_scheduled_jobs")
}

model SocialNetworkingEvent {
  id                 String                        @id @default(uuid())
  ownerUserId        BigInt
  title              String
  normalizedTitle    String
  description        String?
  organizer          String?
  venue              String?
  city               String?
  address            String?
  startAt            DateTime
  endAt              DateTime?
  timezone           String                        @default("Europe/Prague")
  format             SocialEventFormat             @default(UNKNOWN)
  categories         String[]                      @default([])
  audience           String?
  priceAmount        Decimal?                      @db.Decimal(12, 2)
  currency           String?
  priceStatus        SocialPriceStatus             @default(UNKNOWN)
  accessType         SocialAccessType              @default(UNKNOWN)
  registrationUrl    String?
  canonicalUrl       String?
  sourceProvider     String
  sourceExternalId   String?
  retrievedAt        DateTime                      @default(now())
  verifiedAt         DateTime?
  verificationStatus SocialVerificationStatus      @default(UNVERIFIED)
  status             SocialEventStatus             @default(SCHEDULED)
  relevanceScore     Int                           @default(0)
  relevanceReasons   String[]                      @default([])
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  sourceReferences   SocialNetworkingEventSource[]
  attendances        SocialEventAttendance[]

  @@unique([ownerUserId, canonicalUrl])
  @@unique([ownerUserId, sourceProvider, sourceExternalId])
  @@index([ownerUserId, startAt, city])
  @@index([ownerUserId, priceStatus, startAt])
  @@map("social_networking_events")
}

model SocialNetworkingEventSource {
  id          String                @id @default(uuid())
  eventId     String
  provider    String
  externalId  String?
  sourceUrl   String
  officialUrl String?
  retrievedAt DateTime              @default(now())
  event       SocialNetworkingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sourceUrl])
  @@index([provider, externalId])
  @@map("social_networking_event_sources")
}

model SocialEventAttendance {
  id           String                     @id @default(uuid())
  ownerUserId  BigInt
  eventId      String
  weeklyPlanId String?
  status       SocialAttendanceStatus     @default(SUGGESTED)
  registeredAt DateTime?
  attendedAt   DateTime?
  notes        String?
  highlights   String?
  lessons      String?
  privacy      SocialVisibility           @default(PRIVATE)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  event        SocialNetworkingEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contacts     SocialAttendanceContact[]
  followUps    SocialNetworkingFollowUp[]
  contentIdeas SocialEventContentIdea[]

  @@unique([ownerUserId, eventId])
  @@index([ownerUserId, status, updatedAt])
  @@index([weeklyPlanId])
  @@map("social_event_attendances")
}

model SocialNetworkingContact {
  id                     String                     @id @default(uuid())
  ownerUserId            BigInt
  displayName            String
  normalizedName         String
  organization           String?
  role                   String?
  profileUrl             String?
  preferredContactMethod String?
  notes                  String?
  consentOrContext       String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  attendances            SocialAttendanceContact[]
  followUps              SocialNetworkingFollowUp[]

  @@unique([ownerUserId, normalizedName, organization])
  @@index([ownerUserId, updatedAt])
  @@map("social_networking_contacts")
}

model SocialAttendanceContact {
  attendanceId      String
  contactId         String
  conversationNotes String?
  followUpIntent    String?
  createdAt         DateTime                @default(now())
  attendance        SocialEventAttendance   @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  contact           SocialNetworkingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([attendanceId, contactId])
  @@index([contactId])
  @@map("social_attendance_contacts")
}

model SocialNetworkingFollowUp {
  id           String                  @id @default(uuid())
  ownerUserId  BigInt
  contactId    String
  attendanceId String?
  title        String
  dueAt        DateTime
  status       SocialFollowUpStatus    @default(OPEN)
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  contact      SocialNetworkingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  attendance   SocialEventAttendance?  @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, status, dueAt])
  @@map("social_networking_follow_ups")
}

model SocialEventContentIdea {
  eventAttendanceId String
  contentIdeaId     String
  provenanceNotes   String
  createdAt         DateTime              @default(now())
  eventAttendance   SocialEventAttendance @relation(fields: [eventAttendanceId], references: [id], onDelete: Cascade)
  contentIdea       SocialContentIdea     @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)

  @@id([eventAttendanceId, contentIdeaId])
  @@index([contentIdeaId])
  @@map("social_event_content_ideas")
}

enum JobEligibilityState {
  ELIGIBLE
  INELIGIBLE
  UNCERTAIN
}

enum JobRecommendationLevel {
  EXCELLENT
  STRONG
  POSSIBLE
  LOW
}

enum JobAvailabilityStatus {
  OPEN_CONFIRMED
  LISTED_UNVERIFIED
  CLOSED_CONFIRMED
  UNKNOWN
}

enum JobApplicationStatus {
  NEW
  SAVED
  DISMISSED
  INTERESTED
  APPLIED
  RECRUITER_CONTACTED
  INTERVIEW_SCHEDULED
  TECHNICAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum JobNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model JobCandidateProfile {
  id                    String              @id @default(uuid())
  name                  String
  professionalTitle     String
  yearsExperience       Int
  educationLevel        String
  languages             Json
  preferredRoles        String[]            @default([])
  avoidedRoles          String[]            @default([])
  preferredLocations    Json
  profileData           Json
  scoringWeights        Json
  excellentThreshold    Int                 @default(85)
  strongThreshold       Int                 @default(70)
  possibleThreshold     Int                 @default(55)
  notificationThreshold Int                 @default(70)
  version               Int                 @default(1)
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  skills                JobCandidateSkill[]
  evaluations           JobEvaluation[]

  @@index([active, updatedAt])
  @@map("job_candidate_profiles")
}

model JobCandidateSkill {
  id          String              @id @default(uuid())
  profileId   String
  name        String
  normalized  String
  proficiency String
  years       Int?
  verified    Boolean             @default(true)
  profile     JobCandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, normalized])
  @@index([normalized])
  @@map("job_candidate_skills")
}

model JobSource {
  id                   String                @id
  name                 String
  baseUrl              String
  collectionStrategy   String
  enabled              Boolean               @default(false)
  fetchIntervalMinutes Int                   @default(240)
  rateLimitPerMinute   Int                   @default(30)
  healthStatus         SourceHealthStatus    @default(UNAVAILABLE)
  termsNote            String?
  disabledReason       String?
  lastCheckedAt        DateTime?
  lastSuccessfulAt     DateTime?
  lastError            String?
  discoveredCount      Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  checkpoints          JobSourceCheckpoint[]
  rawJobs              JobRawJob[]
  references           JobSourceReference[]
  errors               JobSourceError[]

  @@index([enabled, healthStatus])
  @@map("job_sources")
}

model JobSourceCheckpoint {
  id            String    @id @default(uuid())
  sourceId      String
  checkpointKey String
  value         Json
  etag          String?
  lastModified  String?
  checkedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  source        JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, checkpointKey])
  @@map("job_source_checkpoints")
}

model JobScrapeRun {
  id              String           @id @default(uuid())
  trigger         RunTrigger
  status          RunStatus        @default(RUNNING)
  baseline        Boolean          @default(false)
  dryRun          Boolean          @default(false)
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  discoveredCount Int              @default(0)
  newCount        Int              @default(0)
  evaluatedCount  Int              @default(0)
  notifiedCount   Int              @default(0)
  sourceFailures  Int              @default(0)
  error           String?
  sourceErrors    JobSourceError[]

  @@index([startedAt])
  @@map("job_scrape_runs")
}

model JobRawJob {
  id                  String    @id @default(uuid())
  sourceId            String
  externalId          String
  jobId               String?
  listingUrl          String
  listingHash         String
  detailHash          String?
  contentHash         String
  rawListing          Json
  rawDetail           Json?
  etag                String?
  lastModified        String?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  lastDetailFetchedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  source              JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  job                 Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([jobId])
  @@index([sourceId, lastSeenAt])
  @@map("job_raw_jobs")
}

model Job {
  id                      String                @id @default(uuid())
  canonicalFingerprint    String                @unique
  title                   String
  normalizedTitle         String
  company                 String
  normalizedCompany       String
  description             String
  shortDescription        String?
  location                String?
  country                 String?
  city                    String?
  workMode                String
  remoteRegions           String[]              @default([])
  salaryMin               Int?
  salaryMax               Int?
  salaryCurrency          String?
  salaryPeriod            String?
  contractType            String?
  seniority               String?
  technologyStack         String[]              @default([])
  originalUrl             String
  canonicalApplicationUrl String?
  publishedAt             DateTime?
  firstSeenAt             DateTime              @default(now())
  lastSeenAt              DateTime              @default(now())
  lastDetailFetchedAt     DateTime?
  contentHash             String
  availabilityStatus      JobAvailabilityStatus @default(LISTED_UNVERIFIED)
  lastAvailabilityCheckAt DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  rawJobs                 JobRawJob[]
  sourceReferences        JobSourceReference[]
  requirements            JobRequirement[]
  evaluations             JobEvaluation[]
  notifications           JobNotification[]
  application             JobApplication?

  @@index([publishedAt])
  @@index([availabilityStatus, lastSeenAt])
  @@index([normalizedCompany, normalizedTitle])
  @@map("jobs")
}

model JobSourceReference {
  id                      String    @id @default(uuid())
  jobId                   String
  sourceId                String
  externalId              String
  sourceUrl               String
  canonicalApplicationUrl String?
  firstSeenAt             DateTime  @default(now())
  lastSeenAt              DateTime  @default(now())
  job                     Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source                  JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@unique([jobId, sourceUrl])
  @@index([jobId])
  @@map("job_source_references")
}

model JobRequirement {
  id         String  @id @default(uuid())
  jobId      String
  category   String
  importance String
  text       String
  normalized String?
  evidence   String?
  job        Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, category, importance])
  @@map("job_requirements")
}

model JobEvaluation {
  id               String                 @id @default(uuid())
  jobId            String
  profileId        String
  profileVersion   Int
  jobContentHash   String
  score            Int
  eligibility      JobEligibilityState
  recommendation   JobRecommendationLevel
  matchingSkills   String[]               @default([])
  missingSkills    String[]               @default([])
  hardBlockers     String[]               @default([])
  uncertainties    String[]               @default([])
  reasoning        String
  scoreBreakdown   Json
  aiProvider       String?
  aiModel          String?
  promptVersion    String?
  tokenUsage       Json?
  estimatedCostUsd Decimal?               @db.Decimal(12, 6)
  evaluatedAt      DateTime               @default(now())
  job              Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profile          JobCandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  versions         JobEvaluationVersion[]
  notifications    JobNotification[]

  @@unique([jobId, profileId])
  @@index([profileId, score, eligibility])
  @@map("job_evaluations")
}

model JobEvaluationVersion {
  id             String        @id @default(uuid())
  evaluationId   String
  profileVersion Int
  jobContentHash String
  result         Json
  evaluatedAt    DateTime      @default(now())
  evaluation     JobEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, profileVersion, jobContentHash])
  @@map("job_evaluation_versions")
}

model JobNotification {
  id              String                    @id @default(uuid())
  jobId           String
  evaluationId    String
  notificationKey String                    @unique
  status          JobNotificationStatus     @default(PENDING)
  createdAt       DateTime                  @default(now())
  sentAt          DateTime?
  lastError       String?
  job             Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evaluation      JobEvaluation             @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  deliveries      JobNotificationDelivery[]

  @@index([status, createdAt])
  @@map("job_notifications")
}

model JobNotificationDelivery {
  id             String                @id @default(uuid())
  notificationId String
  provider       String
  recipient      String
  status         JobNotificationStatus @default(PENDING)
  attempts       Int                   @default(0)
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  notification   JobNotification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, provider, recipient])
  @@index([status, updatedAt])
  @@map("job_notification_deliveries")
}

model JobApplication {
  id              String               @id @default(uuid())
  jobId           String               @unique
  status          JobApplicationStatus @default(NEW)
  unread          Boolean              @default(true)
  saved           Boolean              @default(false)
  followUpAt      DateTime?
  appliedAt       DateTime?
  statusChangedAt DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  job             Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  notes           JobApplicationNote[]

  @@index([status, updatedAt])
  @@index([unread, saved])
  @@map("job_applications")
}

model JobApplicationNote {
  id            String         @id @default(uuid())
  applicationId String
  note          String
  createdAt     DateTime       @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("job_application_notes")
}

model JobSourceError {
  id         String        @id @default(uuid())
  sourceId   String
  runId      String?
  errorCode  String?
  message    String
  retryable  Boolean       @default(false)
  occurredAt DateTime      @default(now())
  source     JobSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  run        JobScrapeRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([sourceId, occurredAt])
  @@index([runId])
  @@map("job_source_errors")
}

model JobSchedule {
  id          String     @id @default(uuid())
  scheduleKey String     @unique
  cron        String
  timezone    String     @default("Europe/Prague")
  enabled     Boolean    @default(true)
  nextRunAt   DateTime
  claimedAt   DateTime?
  leaseUntil  DateTime?
  lastRunAt   DateTime?
  lastStatus  RunStatus?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([enabled, nextRunAt])
  @@map("job_schedules")
}

  weeklyPlanId                String?
  title                       String
  slug                        String?
  channel                     SocialChannel
  format                      SocialContentFormat
  contentPillar               String
  targetAudience              String
  objective                   SocialBusinessObjective
  angle                       String
  planningReason              String
  similarityWarning           String?
  hook                        String?
  outline                     Json?
  prompt                      String?
  draft                       String?
  finalContent                String?
  cta                         String?
  requiredAssets              String[]                   @default([])

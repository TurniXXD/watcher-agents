  updatedAt    DateTime     @updatedAt
  chatConfig   TelegramChat @relation(fields: [chatConfigId], references: [id], onDelete: Cascade)

  @@unique([chatConfigId, scope, url])
  @@unique([chatConfigId, builtInKey])
  @@index([chatConfigId, scope, enabled])
}

model NewsTopic {
  id              String       @id @default(uuid())

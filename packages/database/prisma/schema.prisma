}

model MuClubSource {
  id               String             @id
  clubId           String
  type             MuClubSourceType
  url              String?
  externalId       String?
  username         String?
  status           MuClubSourceStatus @default(ACTIVE)
  lastCheckedAt    DateTime?
  lastSuccessfulAt DateTime?
  lastError        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  club             MuClub             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  activities       MuClubActivity[]
  sourceRuns       MuSourceRun[]

  @@index([clubId, status])
  @@map("mu_club_sources")
}

model InstagramAccount {
  username      String          @id
  displayName   String?
  biography     String?
  profileUrl    String
  externalLinks Json
  fetchedAt     DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  posts         InstagramPost[]

  @@map("instagram_accounts")
}

model InstagramPost {
  id          String           @id
  username    String
  shortcode   String?
  caption     String?
  publishedAt DateTime?
  url         String
  mediaType   String?
  imageUrl    String?
  contentHash String
  raw         Json?
  fetchedAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  account     InstagramAccount @relation(fields: [username], references: [username], onDelete: Cascade)

  @@unique([username, shortcode])
  @@index([username, publishedAt])
  @@map("instagram_posts")
}

model MuClubActivity {
  id             String             @id @default(uuid())
  clubId         String
  sourceId       String
  externalItemId String
  contentHash    String
  type           MuClubActivityType
  title          String
  summary        String
  sourceUrl      String
  publishedAt    DateTime?
  startAt        DateTime?
  deadlineAt     DateTime?
  location       String?
  signupUrl      String?
  importance     Int
  confidence     Float
  raw            Json
  detectedAt     DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  club           MuClub             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  source         MuClubSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalItemId])
  @@unique([clubId, contentHash])
  @@index([detectedAt, importance])
  @@index([clubId, startAt])
  @@map("mu_club_activities")
}

model MuMonitorState {
  id            String    @id
  runInProgress Boolean   @default(false)
  runStartedAt  DateTime?

  pricedIn          String
  primaryDrivers    Json
  risks             Json
  dataCoverage      Float
  dataQuality       String
  materialDataGaps  Json
  decision          Json?
  lastEventId       String
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([attentionScore, updatedAt])
  @@index([verdict, updatedAt])
}

model ThesisRevision {
  id                    String         @id @default(uuid())
  ticker                String
  eventId               String         @unique
  processedItemId       String
  analysisId            String         @unique
  thesisChange          String
  informationChange     String

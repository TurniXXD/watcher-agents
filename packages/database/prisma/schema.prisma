  normalizedTitle      String
  description          String?
  startAt              DateTime
  endAt                DateTime?
  venueName            String?
  venueAddress         String?
  latitude             Float?
  longitude            Float?
  city                  String                @default("Brno")
  organizerName         String?
  organizerUrl          String?
  categories            String[]
  language              String?
  priceAmount           Float?
  priceCurrency         String?
  priceFree             Boolean?
  priceText             String?
  registrationRequired Boolean?
  registrationUrl       String?
  registrationDeadline DateTime?
  imageUrl               String?
  relevanceScore        Int

  @@index([watcherConfigId, startedAt])
}

model BacktestOutcome {
  id                            String               @id @default(uuid())
  watcherConfigId               String
  targetType                    ValidationTargetType
  targetId                      String
  ticker                        String
  anchorAt                      DateTime
  anchorPrice                   Decimal?             @db.Decimal(24, 8)
  nextOpenPrice                 Decimal?             @db.Decimal(24, 8)

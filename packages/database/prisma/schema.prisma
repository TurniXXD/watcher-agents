  materialChange  Boolean       @default(false)
  reasons         Json          @default("[]")
  createdAt       DateTime      @default(now())
  processedItem   ProcessedItem @relation(fields: [processedItemId], references: [id], onDelete: Cascade)

  @@index([ticker, reportedAt])
  @@index([ticker, materialChange, reportedAt])
}

model ShortInterestSnapshot {
  id                    String        @id @default(uuid())
  processedItemId       String        @unique
  ticker                String
  settlementDate        DateTime
  currentShortPosition  BigInt
  previousShortPosition BigInt?
  changeShares          BigInt?
  changePercent         Decimal?      @db.Decimal(12, 6)
  averageDailyVolume    BigInt?
  daysToCover           Decimal?      @db.Decimal(12, 6)
  materialChange        Boolean       @default(false)
  reasons               Json          @default("[]")
  createdAt             DateTime      @default(now())
  processedItem         ProcessedItem @relation(fields: [processedItemId], references: [id], onDelete: Cascade)

  @@index([ticker, settlementDate])
  @@index([ticker, materialChange, settlementDate])
}

model Catalyst {
  id             String            @id @default(uuid())
  eventId        String
  ticker         String
  catalystType   CatalystType
  description    String
  expectedStart  DateTime?
  expectedEnd    DateTime?
  exactDateKnown Boolean           @default(false)
  proximity      CatalystProximity
  impact         Materiality
  direction      CatalystDirection
  status         CatalystStatus
  fingerprint    String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  event          CanonicalEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([ticker, status, expectedStart])
  @@index([proximity, impact])
}

model SourceHealth {
  id                  String             @id @default(uuid())
  watcherConfigId     String
  source              String
  target              String
  status              SourceHealthStatus @default(HEALTHY)
  consecutiveFailures Int                @default(0)
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  backoffUntil        DateTime?
  lastError           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  watcherConfig       WatcherConfig      @relation(fields: [watcherConfigId], references: [id], onDelete: Cascade)

  @@unique([watcherConfigId, source, target])
  @@index([status, backoffUntil])
}

model Analysis {
  id               String          @id @default(uuid())
  runId            String
  processedItemId  String
  status           AnalysisStatus
  result           Json?
  error            String?
  durationMs       Int?
  llmCallCount     Int             @default(0)
  promptTokens     Int?
  completionTokens Int?
  estimatedCostUsd Decimal         @default(0) @db.Decimal(18, 8)
  createdAt        DateTime        @default(now())
  run              WatcherRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  processedItem    ProcessedItem   @relation(fields: [processedItemId], references: [id], onDelete: Cascade)
  thesisRevision   ThesisRevision?

  @@unique([runId, processedItemId])
  @@index([processedItemId])
}

model StockAlert {
  id                  String         @id @default(uuid())
  watcherConfigId     String
  runId               String
  eventId             String
  ticker              String
  type                StockAlertType
  severity            AlertSeverity
  title               String
  reasons             Json
  snapshot            Json
  eventDetectedAt     DateTime
  analysisCompletedAt DateTime
  deliverAfter        DateTime       @default(now())
  deliveryClaimedAt   DateTime?
  sentAt              DateTime?
  deliveryAttempts    Int            @default(0)
  deliveryError       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  watcherConfig       WatcherConfig  @relation(fields: [watcherConfigId], references: [id], onDelete: Cascade)
  run                 WatcherRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  event               CanonicalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([watcherConfigId, eventId])
  @@index([watcherConfigId, sentAt, createdAt])
  @@index([runId, sentAt])
  @@index([severity, createdAt])
}

model CompanyThesisState {
  ticker            String   @id
  thesis            String
  verdict           String
  confidence        Float
  attentionScore    Int
  bullScore         Float
  bearScore         Float
  netSignal         Float
  signalGroups      Json
  catalysts         Json

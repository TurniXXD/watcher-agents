  @@map("mu_monitor_runs")
}

model MuSourceRun {
  id           String       @id @default(uuid())
  monitorRunId String
  sourceId     String
  success      Boolean
  itemCount    Int          @default(0)
  error        String?
  durationMs   Int
  createdAt    DateTime     @default(now())
  monitorRun   MuMonitorRun @relation(fields: [monitorRunId], references: [id], onDelete: Cascade)
  source       MuClubSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([monitorRunId])
  @@index([sourceId, createdAt])
  @@map("mu_source_runs")
}

model BrnoEvent {
  id                   String                @id @default(uuid())
  fingerprint          String                @unique
  contentHash          String

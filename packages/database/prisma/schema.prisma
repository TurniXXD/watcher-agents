generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WatcherKind {
  STOCKS
  PUBLICATIONS
}

enum RunTrigger {
  MANUAL
  SCHEDULED
}

enum RunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum AnalysisStatus {
  SUCCESS
  FAILED
}

enum StockSourceType {
  SEC
  INVESTOR_RELATIONS
  NEWS
  PRICE
}

enum PublicationSourceType {
  PUBMED
  BIORXIV
  CLINICAL_TRIALS
  FDA
}

model TelegramChat {
  id             String          @id @default(uuid())
  kind           WatcherKind
  chatId         BigInt
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  watcherConfig  WatcherConfig?
  stocks         Stock[]
  queries        PublicationQuery[]

  @@unique([kind, chatId])
}

model WatcherConfig {
  id               String       @id @default(uuid())
  chatConfigId     String       @unique
  enabled          Boolean      @default(true)
  schedule         String       @default("0 8 * * *")
  timezone         String       @default("Europe/Prague")
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  lastRunStatus    RunStatus?
  runInProgress    Boolean      @default(false)
  runStartedAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  chatConfig       TelegramChat @relation(fields: [chatConfigId], references: [id], onDelete: Cascade)
  runs             WatcherRun[]

  @@index([enabled, nextRunAt])
}

model WatcherRun {
  id                String          @id @default(uuid())
  watcherConfigId   String
  trigger           RunTrigger
  status            RunStatus       @default(RUNNING)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  fetchedCount      Int             @default(0)
  newItemCount      Int             @default(0)
  analyzedCount     Int             @default(0)
  failedAnalysisCount Int           @default(0)
  error             String?
  watcherConfig     WatcherConfig   @relation(fields: [watcherConfigId], references: [id], onDelete: Cascade)
  sourceFailures    SourceFailure[]
  analyses          Analysis[]

  @@index([watcherConfigId, startedAt])
}

model SourceFailure {
  id          String     @id @default(uuid())
  runId       String
  source      String
  target      String
  message     String
  createdAt   DateTime   @default(now())
  run         WatcherRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model ProcessedItem {
  id          String       @id @default(uuid())
  watcherKind WatcherKind
  source      String
  externalId  String
  title       String
  url         String
  publishedAt DateTime?
  contentHash String
  metadata    Json
  firstSeenAt DateTime     @default(now())
  analyses    Analysis[]

  @@unique([watcherKind, source, externalId])
  @@index([watcherKind, contentHash])
  @@index([url])
}

model Analysis {
  id              String         @id @default(uuid())
  runId           String
  processedItemId String
  status          AnalysisStatus
  result          Json?
  error           String?
  createdAt       DateTime       @default(now())
  run             WatcherRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  processedItem   ProcessedItem  @relation(fields: [processedItemId], references: [id], onDelete: Cascade)

  @@unique([runId, processedItemId])
  @@index([processedItemId])
}

model Stock {
  id            String              @id @default(uuid())
  chatConfigId  String
  symbol        String
  companyName   String?
  cik           String?
  createdAt     DateTime            @default(now())
  chatConfig    TelegramChat        @relation(fields: [chatConfigId], references: [id], onDelete: Cascade)
  sources       StockSourceConfig[]

  @@unique([chatConfigId, symbol])
}

model StockSourceConfig {
  id        String          @id @default(uuid())
  stockId   String
  source    StockSourceType
  enabled   Boolean         @default(false)
  config    Json?
  stock     Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, source])
}

model PublicationQuery {
  id              String                    @id @default(uuid())
  chatConfigId    String
  query           String
  normalizedQuery String
  createdAt       DateTime                  @default(now())
  chatConfig      TelegramChat              @relation(fields: [chatConfigId], references: [id], onDelete: Cascade)
  sources         PublicationSourceConfig[]

  @@unique([chatConfigId, normalizedQuery])
}

model PublicationSourceConfig {
  id       String                @id @default(uuid())
  queryId  String
  source   PublicationSourceType
  enabled  Boolean               @default(false)
  config   Json?
  query    PublicationQuery      @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([queryId, source])
}

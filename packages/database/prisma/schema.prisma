generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WatcherKind {
  STOCKS
  PUBLICATIONS
  NEWS
}

enum RunTrigger {
  MANUAL
  SCHEDULED
}

enum RunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum AnalysisStatus {
  SUCCESS
  FAILED
}

enum ValidationTargetType {
  THESIS
  ALERT
  SIGNAL
}

enum StockSourceType {
  SEC
  INVESTOR_RELATIONS
  NEWS
  TRADINGVIEW_NEWS
  PRICE
  FINVIZ
  ZACKS
  EARNINGS_WHISPERS
  QUIVER_INSIDERS
  QUIVER_CONTRACTS
  QUIVER_PATENTS
  QUIVER_CONGRESS
  QUIVER_OFF_EXCHANGE
  QUIVER_LOBBYING
  ALPHA_VANTAGE_OPTIONS
  ALPHA_VANTAGE_INSTITUTIONAL
  FINRA_SHORT_INTEREST
  CLINICAL_TRIALS
  FDA
}

enum PublicationSourceType {
  PUBMED
  BIORXIV
  CLINICAL_TRIALS
  FDA
}

enum MonitoringTier {
  CORE
  WATCH
  DISCOVERY
  INVESTIGATE
}

enum MonitoringMode {
  LOW_RESOLUTION
  NORMAL
  HIGH_RESOLUTION
  EVENT_MODE
}

enum CanonicalEventType {
  EARNINGS
  GUIDANCE
  INSIDER_TRANSACTION
  CLINICAL_TRIAL
  FDA_DECISION
  PRODUCT_LAUNCH
  GOVERNMENT_CONTRACT
  CONTRACT
  PATENT
  ACQUISITION
  MERGER
  DIVESTITURE
  FINANCING
  CAPITAL_RETURN
  PARTNERSHIP
  INDUSTRY
  PRICE_MOVE
  CAPITAL_RAISE
  BUYBACK
  DIVIDEND
  MANAGEMENT_CHANGE
  ANALYST_REVISION
  LEGAL
  REGULATORY
  CONGRESSIONAL_TRANSACTION
  INSTITUTIONAL_POSITIONING
  OFF_EXCHANGE_ANOMALY
  COMPETITOR_EVENT
  MACRO_EVENT
  PRICE_ANOMALY
  VOLUME_ANOMALY
  OPTIONS_ANOMALY
  SHORT_INTEREST_CHANGE
  OTHER
}

enum EventDirection {
  POSITIVE
  NEGATIVE
  MIXED
  NEUTRAL
  UNKNOWN
}

enum EventSurprise {
  NONE
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum Materiality {
  NONE
  LOW
  MEDIUM
  HIGH
  EXTREME
}

enum EventAction {
  STORE
  STATE_UPDATE
  TARGETED_ANALYSIS
  FULL_ANALYSIS
  IMMEDIATE_ANALYSIS
}

enum EvidenceRole {
  PRIMARY
  CONFIRMATION
  REACTION
  INTERPRETATION
}

enum EventDecision {
  ANALYZE
  STORED
  DUPLICATE
  COOLDOWN
}

enum StockEventAnalysisStatus {
  PENDING
  ANALYZING
  ANALYZED
  SKIPPED
  FAILED
}

enum SourceHealthStatus {
  HEALTHY
  DEGRADED
  RATE_LIMITED
  UNAVAILABLE
}

enum DiscoverySignalStatus {
  OBSERVED
  INVESTIGATING
  PROMOTED
  EXPIRED
}

enum DiscoveryScanMode {
  DAILY
  INTRADAY
}

enum DiscoveryTrigger {
  PRICE_MOVE
  MOST_ACTIVE
}

enum InsiderTransactionType {
  OPEN_MARKET_BUY
  OPEN_MARKET_SELL
  TEN_B5_1_SALE
  TAX_SELL_TO_COVER
  OPTION_EXERCISE
  RSU_VESTING
  GIFT
  OTHER
}

enum CatalystType {
  EARNINGS
  CLINICAL_RESULTS
  FDA_DECISION
  PRODUCT_LAUNCH
  COURT_DECISION
  INVESTOR_DAY
  CONTRACT
  GUIDANCE
  PATENT_EXPIRATION
  REGULATORY_DECISION
}

enum CatalystProximity {
  NONE
  LOW
  MEDIUM
  HIGH
  IMMINENT
}

enum CatalystDirection {
  POSITIVE
  NEGATIVE
  BINARY
  UNKNOWN
}

enum CatalystStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StockAlertType {
  HIGH_PRIORITY
  THESIS_CHANGE
  VERDICT_CHANGE
  EXTREME_CATALYST
  INSIDER_CLUSTER
  UNEXPLAINED_ACTIVITY
  ASYMMETRY_CHANGE
}

enum AlertSeverity {
  INFO
  MEDIUM
  HIGH
  EXTREME
}

enum BriefingWatcherBot {
  STOCKS
  MEDICAL
  NEWS
  MU_CLUBS
}

enum MuClubSourceType {
  WEBSITE
  INSTAGRAM
  FACEBOOK
  RSS
  CALENDAR
  LINKTREE
  OTHER
}

enum MuClubSourceStatus {
  ACTIVE
  UNSUPPORTED
  BROKEN
  MANUAL
  NO_MONITORABLE_SOURCE
}

enum MuClubActivityType {
  NEW_EVENT
  REGISTRATION_OPEN
  RECRUITMENT
  MEETING
  WORKSHOP
  LECTURE
  DEADLINE
  TRIP
  VOLUNTEER_OPPORTUNITY
  ANNOUNCEMENT
  OTHER_RELEVANT_UPDATE
}

enum MuMonitorRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum NewsScope {
  CZECH
  GLOBAL
}

enum BriefingConfidence {
  LOW
  MEDIUM
  HIGH
}

enum BriefingEventStatus {
  NEW
  DEVELOPING
  UNCHANGED
  RESOLVED
}

enum BriefingVoice {
  AMY
  HFC_FEMALE
  HFC_MALE
}

enum BriefingOnboardingStep {
  LOCATION
  VOICE
  GOOGLE_CALENDAR
  SUBSCRIPTIONS
  BRIEFING_TIME
  COMPLETE
}

enum BriefingLocationMode {
  STATIC
  LAST_SHARED
  DISABLED
}

enum BriefingRunType {
  SCHEDULED
  MANUAL
  TEST
}

enum BriefingRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum BriefingDeliveryChannel {
  VOICE
  INDEX
  TRANSCRIPT
  TEXT_FALLBACK
}

enum BriefingDeliveryStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BriefingWatcherHealthStatus {
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum BriefingFeedbackRating {
  USEFUL
  NOT_USEFUL
  TOO_LONG
}

model BriefingEvent {
  id                 String                      @id
  watcherBot         BriefingWatcherBot
  externalEventId    String?
  occurredAt         DateTime?
  publishedAt        DateTime?
  detectedAt         DateTime
  createdAt          DateTime
  updatedAt          DateTime
  category           String
  subcategory        String?
  title              String
  summary            String
  importance         Int
  novelty            Int
  relevance          Int
  urgency            Int
  actionable         Boolean
  action             String?
  entities           Json
  tags               String[]
  sourceUrls         String[]
  primarySource      String?
  confidence         BriefingConfidence
  status             BriefingEventStatus
  deduplicationKey   String?
  relatedEventIds    String[]                    @default([])
  metadata           Json?
  embedding          Unsupported("vector")?
  embeddingModel     String?
  embeddingInputHash String?
  embeddingUpdatedAt DateTime?
  storyClusters      BriefingStoryClusterEvent[]

  @@unique([watcherBot, externalEventId])
  @@unique([watcherBot, deduplicationKey])
  @@index([watcherBot, detectedAt])
  @@index([status, detectedAt])
  @@map("briefing_events")
}

model BriefingStoryCluster {
  id           String                      @id
  title        String
  summary      String
  status       BriefingEventStatus
  importance   Int
  novelty      Int
  relevance    Int
  urgency      Int
  actionable   Boolean
  actionItems  String[]                    @default([])
  watcherBots  BriefingWatcherBot[]
  entities     Json
  sourceUrls   String[]                    @default([])
  firstEventAt DateTime
  lastEventAt  DateTime
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  events       BriefingStoryClusterEvent[]

  @@index([status, lastEventAt])
  @@map("briefing_story_clusters")
}

model BriefingStoryClusterEvent {
  clusterId String
  eventId   String               @unique
  createdAt DateTime             @default(now())
  cluster   BriefingStoryCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  event     BriefingEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([clusterId, eventId])
  @@map("briefing_story_cluster_events")
}

model BriefingSettings {
  id                     String                    @id @default(uuid())
  telegramChatId         BigInt                    @unique
  onboardingComplete     Boolean                   @default(false)
  language               String                    @default("en")
  voice                  BriefingVoice             @default(AMY)
  timezone               String                    @default("Europe/Prague")
  briefingTime           String                    @default("07:00;20:00;weekly:MON:07:00;weekly:SUN:20:00")
  targetDurationMinutes  Int                       @default(7)
  maximumDurationMinutes Int                       @default(15)
  sendTranscript         Boolean                   @default(false)
  calendarEnabled        Boolean                   @default(false)
  weatherEnabled         Boolean                   @default(true)
  priorityKeywords       String[]                  @default([])
  mutedKeywords          String[]                  @default([])
  nextBriefingAt         DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  subscriptions          BriefingSubscription[]
  location               BriefingLocation?
  onboarding             OnboardingState?
  runs                   BriefingRun[]
  storyStates            BriefingStoryState[]
  calendarIntegration    CalendarIntegrationState?
  feedback               BriefingFeedback[]

  @@index([onboardingComplete, nextBriefingAt])
  @@map("briefing_settings")
}

model BriefingSubscription {
  id         String             @id @default(uuid())
  settingsId String
  watcherBot BriefingWatcherBot
  enabled    Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  settings   BriefingSettings   @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, watcherBot])
  @@index([settingsId, enabled])
  @@map("briefing_subscriptions")
}

model BriefingLocation {
  id         String               @id @default(uuid())
  settingsId String               @unique
  mode       BriefingLocationMode
  city       String?
  country    String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  settings   BriefingSettings     @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@map("briefing_locations")
}

model OnboardingState {
  id          String                 @id @default(uuid())
  settingsId  String                 @unique
  completed   Boolean                @default(false)
  currentStep BriefingOnboardingStep @default(LOCATION)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  settings    BriefingSettings       @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@map("onboarding_state")
}

model BriefingRun {
  id                         String                    @id @default(uuid())
  settingsId                 String
  idempotencyKey             String                    @unique
  type                       BriefingRunType
  scheduledFor               DateTime?
  startedAt                  DateTime                  @default(now())
  completedAt                DateTime?
  periodStart                DateTime
  periodEnd                  DateTime
  subscriptions              BriefingWatcherBot[]
  location                   Json?
  weatherAvailable           Boolean                   @default(false)
  calendarAvailable          Boolean                   @default(false)
  status                     BriefingRunStatus         @default(RUNNING)
  selectedStoryIds           String[]                  @default([])
  displayScript              String?
  ttsScript                  String?
  wordCount                  Int?
  targetDurationSeconds      Int
  maximumDurationSeconds     Int
  actualAudioDurationSeconds Float?
  voice                      BriefingVoice?
  telegramMessageId          String?
  failureReason              String?
  briefingDataCoverage       Int?
  metrics                    Json?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  settings                   BriefingSettings          @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  lastForStoryStates         BriefingStoryState[]      @relation("LastBriefingRun")
  deliveryAttempts           BriefingDeliveryAttempt[]
  feedback                   BriefingFeedback?

  @@index([settingsId, type, status, startedAt])
  @@index([settingsId, periodEnd])
  @@map("briefing_runs")
}

model BriefingFeedback {
  id         String                 @id @default(uuid())
  settingsId String
  runId      String                 @unique
  rating     BriefingFeedbackRating
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  settings   BriefingSettings       @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  run        BriefingRun            @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([settingsId, createdAt])
  @@map("briefing_feedback")
}

model BriefingWatcherHealth {
  watcherBot              BriefingWatcherBot          @id
  status                  BriefingWatcherHealthStatus
  lastRunAt               DateTime
  lastSuccessAt           DateTime?
  lastFailureAt           DateTime?
  lastError               String?
  eventsEmitted           Int                         @default(0)
  failedEventPublications Int                         @default(0)
  sourceFailures          Int                         @default(0)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@index([status, lastRunAt])
  @@map("briefing_watcher_health")
}

model BriefingDeliveryAttempt {
  id                String                  @id @default(uuid())
  runId             String
  channel           BriefingDeliveryChannel
  attempt           Int
  status            BriefingDeliveryStatus  @default(RUNNING)
  telegramMessageId String?
  failureReason     String?
  startedAt         DateTime                @default(now())
  completedAt       DateTime?
  run               BriefingRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, channel, attempt])
  @@index([runId, channel, status])
  @@map("briefing_delivery_attempts")
}

model BriefingStoryState {
  id                String              @id @default(uuid())
  settingsId        String
  storyId           String
  firstMentionedAt  DateTime
  lastMentionedAt   DateTime
  lastSummary       String
  importance        Int
  status            BriefingEventStatus
  lastBriefingRunId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  settings          BriefingSettings    @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  lastBriefingRun   BriefingRun?        @relation("LastBriefingRun", fields: [lastBriefingRunId], references: [id], onDelete: SetNull)

  @@unique([settingsId, storyId])
  @@index([settingsId, status, lastMentionedAt])
  @@map("briefing_story_states")
}

model CalendarIntegrationState {
  id                    String           @id @default(uuid())
  settingsId            String           @unique
  encryptedRefreshToken String?
  oauthStateHash        String?          @unique
  oauthStateExpiresAt   DateTime?
  calendarIds           String[]         @default(["primary"])
  connectedAt           DateTime?
  lastRefreshAt         DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  settings              BriefingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@map("calendar_integration_state")
}

model TelegramChat {
  id            String             @id @default(uuid())
  kind          WatcherKind
  chatId        BigInt
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  watcherConfig WatcherConfig?
  stocks        Stock[]
  queries       PublicationQuery[]
  newsFeeds     NewsFeed[]
  newsTopics    NewsTopic[]

  @@unique([kind, chatId])
}

model WatcherConfig {
  id                       String            @id @default(uuid())
  chatConfigId             String            @unique
  enabled                  Boolean           @default(true)
  schedule                 String            @default("0 8 * * *")
  timezone                 String            @default("Europe/Prague")
  lastRunAt                DateTime?
  nextRunAt                DateTime?
  lastRunStatus            RunStatus?
  runInProgress            Boolean           @default(false)
  runStartedAt             DateTime?
  discoveryScanInProgress  Boolean           @default(false)
  discoveryScanStartedAt   DateTime?
  lastDiscoveryScanAt      DateTime?
  nextDiscoveryScanAt      DateTime?         @default(now())
  reconciliationInProgress Boolean           @default(false)
  reconciliationStartedAt  DateTime?
  lastReconciliationAt     DateTime?
  nextReconciliationAt     DateTime?         @default(now())
  sourceSettings           Json              @default("{}")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  chatConfig               TelegramChat      @relation(fields: [chatConfigId], references: [id], onDelete: Cascade)
  runs                     WatcherRun[]
  sourceHealth             SourceHealth[]
  discoveryScans           DiscoveryScan[]
  discoverySignals         DiscoverySignal[]
  alerts                   StockAlert[]
  validationRuns           ValidationRun[]
  backtestOutcomes         BacktestOutcome[]

  @@index([enabled, nextRunAt])
  @@index([enabled, nextDiscoveryScanAt])
  @@index([enabled, nextReconciliationAt])
}

model WatcherRun {
  id                  String             @id @default(uuid())
  watcherConfigId     String
  trigger             RunTrigger
  status              RunStatus          @default(RUNNING)
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  fetchedCount        Int                @default(0)
  newItemCount        Int                @default(0)
  analyzedCount       Int                @default(0)
  failedAnalysisCount Int                @default(0)
  error               String?
  watcherConfig       WatcherConfig      @relation(fields: [watcherConfigId], references: [id], onDelete: Cascade)
  sourceFailures      SourceFailure[]
  analyses            Analysis[]
  eventObservations   EventObservation[]
  alerts              StockAlert[]

  @@index([watcherConfigId, startedAt])
}

model SourceFailure {
  id        String     @id @default(uuid())
  runId     String
  source    String
  target    String
  message   String
  createdAt DateTime   @default(now())
  run       WatcherRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model ProcessedItem {
  id                String                 @id @default(uuid())
  watcherKind       WatcherKind
  source            String
  externalId        String
  title             String
  url               String
  publishedAt       DateTime?
  ticker            String?
  sourceType        String                 @default("OTHER")
  sourceUrl         String?
  primarySource     Boolean                @default(false)
  discoveredAt      DateTime               @default(now())
  eventAt           DateTime?
  category          String                 @default("OTHER")
  headline          String?
  rawText           String?
  normalizedFacts   Json                   @default("{}")
  entities          Json                   @default("[]")
  reliability       Float                  @default(0.5)
  contentHash       String
  metadata          Json
  firstSeenAt       DateTime               @default(now())
  analyses          Analysis[]
  eventObservations EventObservation[]
  primaryForEvents  CanonicalEvent[]       @relation("PrimaryEvidence")
  insiderSignal     InsiderSignal?
  marketSnapshot    MarketSnapshot?
  offExchange       OffExchangeSnapshot?
  optionsSnapshot   OptionsSnapshot?
  institutional     InstitutionalSnapshot?
  shortInterest     ShortInterestSnapshot?
  thesisRevisions   ThesisRevision[]

  @@unique([watcherKind, source, externalId])
  @@index([watcherKind, contentHash])
  @@index([url])
}

model EventChain {
  id             String           @id @default(uuid())
  ticker         String
  primaryEventId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  events         CanonicalEvent[]

  @@index([ticker, createdAt])
}

model CanonicalEvent {
  id                  String             @id @default(uuid())
  ticker              String
  eventType           CanonicalEventType
  eventTypes          CanonicalEventType[] @default([])
  title               String
  fingerprint         String             @unique
  occurredAt          DateTime?
  firstPublicAt       DateTime?
  firstDetectedAt     DateTime
  lastSeenAt          DateTime             @default(now())
  direction           EventDirection
  magnitude           Json               @default("{}")
  surprise            EventSurprise
  materiality         Materiality
  materialityScore    Int
  materialityReasons  Json               @default("[]")
  action              EventAction
  evidencePriority    Int
  primaryEvidenceId   String
  primaryDriverId     String?
  chainId             String
  analysisClaimedAt   DateTime?
  analysisCompletedAt DateTime?
  analysisStatus      StockEventAnalysisStatus @default(PENDING)
  analysisError       String?
  embedding           Unsupported("vector")?
  embeddingModel      String?
  embeddingInputHash  String?
  embeddingUpdatedAt  DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  primaryEvidence     ProcessedItem      @relation("PrimaryEvidence", fields: [primaryEvidenceId], references: [id], onDelete: Restrict)
  chain               EventChain         @relation(fields: [chainId], references: [id], onDelete: Restrict)
  observations        EventObservation[]
  catalysts           Catalyst[]
  thesisRevision      ThesisRevision?
  alerts              StockAlert[]

  @@index([ticker, eventType, occurredAt])
  @@index([ticker, firstDetectedAt])
  @@index([ticker, lastSeenAt])
  @@index([chainId])
}

model EventObservation {
  id              String         @id @default(uuid())
  eventId         String
  processedItemId String
  runId           String
  role            EvidenceRole
  decision        EventDecision
  createdEvent    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  event           CanonicalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  processedItem   ProcessedItem  @relation(fields: [processedItemId], references: [id], onDelete: Cascade)
  run             WatcherRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([eventId, processedItemId])
  @@index([runId])
  @@index([processedItemId])
}

model AnalysisCooldown {
  scopeKey      String   @id
  cooldownUntil DateTime
  lastClaimedAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InsiderSignal {
  id                    String                 @id @default(uuid())
  processedItemId       String                 @unique
  ticker                String
  insider               String
  role                  String?
  transactionType       InsiderTransactionType
  occurredAt            DateTime?
  shares                Decimal?               @db.Decimal(24, 4)
  price                 Decimal?               @db.Decimal(24, 8)
  transactionValue      Decimal?               @db.Decimal(24, 2)
  holdingsBefore        Decimal?               @db.Decimal(24, 4)
  holdingsAfter         Decimal?               @db.Decimal(24, 4)
  holdingsChangePercent Decimal?               @db.Decimal(12, 6)
  planned               Boolean                @default(false)
  discretionary         Boolean                @default(false)
  convictionScore       Int
  clusterSize           Int                    @default(1)
  rationale             Json                   @default("[]")
  createdAt             DateTime               @default(now())
  processedItem         ProcessedItem          @relation(fields: [processedItemId], references: [id], onDelete: Cascade)

  @@index([ticker, transactionType, occurredAt])
  @@index([ticker, convictionScore])
}

model MarketSnapshot {
  id                             String        @id @default(uuid())
  processedItemId                String        @unique
  ticker                         String
  observedAt                     DateTime
  open                           Decimal       @db.Decimal(24, 8)
  high                           Decimal       @db.Decimal(24, 8)
  low                            Decimal       @db.Decimal(24, 8)
  close                          Decimal       @db.Decimal(24, 8)
  volume                         BigInt
  dailyReturnPercent             Decimal?      @db.Decimal(12, 6)
  weeklyReturnPercent            Decimal?      @db.Decimal(12, 6)
  monthlyReturnPercent           Decimal?      @db.Decimal(12, 6)
  ninetyDayReturnPercent         Decimal?      @db.Decimal(12, 6)
  relativeVolume                 Decimal?      @db.Decimal(12, 6)
  returnVolatilityRatio          Decimal?      @db.Decimal(12, 6)
  gapPercent                     Decimal?      @db.Decimal(12, 6)
  atrPercent                     Decimal?      @db.Decimal(12, 6)
  realizedVolatilityPercent      Decimal?      @db.Decimal(12, 6)
  movingAverage20DistancePercent Decimal?      @db.Decimal(12, 6)
  rsi14                          Decimal?      @db.Decimal(12, 6)
  preMarketChangePercent         Decimal?      @db.Decimal(12, 6)
  afterHoursChangePercent        Decimal?      @db.Decimal(12, 6)
  relativeSectorPercent          Decimal?      @db.Decimal(12, 6)
  relativeIndexPercent           Decimal?      @db.Decimal(12, 6)
  priceAnomaly                   Boolean       @default(false)
  volumeAnomaly                  Boolean       @default(false)
  gapAnomaly                     Boolean       @default(false)
  volatilityExpansion            Boolean       @default(false)
  unexplained                    Boolean       @default(false)
  primaryDriverId                String?
  createdAt                      DateTime      @default(now())
  processedItem                  ProcessedItem @relation(fields: [processedItemId], references: [id], onDelete: Cascade)

  @@index([ticker, observedAt])
  @@index([ticker, unexplained, observedAt])
}

model OffExchangeSnapshot {
  id              String        @id @default(uuid())
  processedItemId String        @unique
  ticker          String
  observedAt      DateTime
  shortVolume     BigInt
  totalVolume     BigInt
  dpi             Decimal       @db.Decimal(12, 6)
  baselineDpi     Decimal?      @db.Decimal(12, 6)
  relativeDpi     Decimal?      @db.Decimal(12, 6)
  anomaly         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  processedItem   ProcessedItem @relation(fields: [processedItemId], references: [id], onDelete: Cascade)

  @@index([ticker, observedAt])
}

model OptionsSnapshot {
  id                       String        @id @default(uuid())
  processedItemId          String        @unique
  ticker                   String
  observedAt               DateTime
  callVolume               BigInt
  putVolume                BigInt
  callOpenInterest         BigInt
  putOpenInterest          BigInt
  putCallVolumeRatio       Decimal?      @db.Decimal(12, 6)
  putCallOpenInterestRatio Decimal?      @db.Decimal(12, 6)
  meanImpliedVolatility    Decimal?      @db.Decimal(12, 6)
  maxVolumeOiRatio         Decimal?      @db.Decimal(12, 6)
  anomaly                  Boolean       @default(false)
  reasons                  Json          @default("[]")
  createdAt                DateTime      @default(now())
  processedItem            ProcessedItem @relation(fields: [processedItemId], references: [id], onDelete: Cascade)

  @@index([ticker, observedAt])
  @@index([ticker, anomaly, observedAt])
}

model InstitutionalSnapshot {
  id              String        @id @default(uuid())
  processedItemId String        @unique
  ticker          String

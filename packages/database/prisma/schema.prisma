  chatConfig      TelegramChat @relation(fields: [chatConfigId], references: [id], onDelete: Cascade)

  @@unique([chatConfigId, scope, normalizedTopic])
  @@index([chatConfigId, scope])
}

model MuClub {
  id           String             @id
  slug         String             @unique
  name         String
  status       MuClubSourceStatus @default(ACTIVE)
  discoveryUrl String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sources      MuClubSource[]
  activities   MuClubActivity[]


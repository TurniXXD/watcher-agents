  returnOneHourPercent          Decimal?             @db.Decimal(12, 6)
  returnOneDayPercent           Decimal?             @db.Decimal(12, 6)
  returnSevenDayPercent         Decimal?             @db.Decimal(12, 6)
  returnThirtyDayPercent        Decimal?             @db.Decimal(12, 6)
  returnNinetyDayPercent        Decimal?             @db.Decimal(12, 6)
  returnTwelveMonthPercent      Decimal?             @db.Decimal(12, 6)

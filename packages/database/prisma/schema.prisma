  @@index([ticker, anchorAt])
}

model Stock {
  id                        String              @id @default(uuid())
  chatConfigId              String
  symbol                    String
  companyName               String?
  cik                       String?
  exchange                  String?
  sector                    String?
  industry                  String?
  marketCap                 Decimal?            @db.Decimal(24, 2)
  currency                  String?
  country                   String?
  investorRelationsUrl      String?
  enabled                   Boolean             @default(true)
  monitoringTier            MonitoringTier      @default(WATCH)
  monitoringMode            MonitoringMode      @default(NORMAL)
  priority                  Int                 @default(50)
  tags                      String[]            @default([])
  watchReason               String?
  watchUntil                DateTime?
  watchStartedAt            DateTime?
  autoDiscovered            Boolean             @default(false)
  attentionScore            Int                 @default(0)
  investigationStartedAt    DateTime?
  investigateUntil          DateTime?
  highResolutionUntil       DateTime?
  lastDiscoverySignalAt     DateTime?
  nextHighResolutionCheckAt DateTime?
  lastHighResolutionCheckAt DateTime?

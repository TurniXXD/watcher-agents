POSTGRES_DB=watcher
POSTGRES_USER=watcher
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://watcher:change-me@postgres:5432/watcher

STOCKS_TELEGRAM_TOKEN=
PUBLICATIONS_TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_ITEMS_PER_RUN=5
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_RETRIES=1
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=120000
SEC_USER_AGENT=Watcher/1.0 admin@example.com
DEFAULT_TIMEZONE=Europe/Prague
LOG_LEVEL=info

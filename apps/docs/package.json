{
  "name": "@watcher/docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs --cache --cache-location ../../.cache/eslint/docs --cache-strategy content && pnpm check:links && pnpm check:reference",
    "check:links": "node scripts/check-links.mjs",
    "check:reference": "node scripts/check-bot-reference.mjs"
  },
  "dependencies": {
    "cn": "0.5.2",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.3",
    "lucide-react": "1.67.0",
    "mermaid": "12.3.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4"
  }
}

    "/ingest/v1/runs/{id}": {
      "get": {
        "tags": [
          "Runs"
        ],
        "operationId": "getIngestRun",
        "summary": "Get an ingestion run created by the calling bot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestRun"
                }
              }
            }

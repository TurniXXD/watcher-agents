{
  "openapi": "3.1.0",
  "info": {
    "title": "Vantuch Content API",
    "version": "1.0.0",
    "description": "Authenticated bot ingestion API. Each bot uses its own credential (`Authorization: Bearer vch_<keyId>_<secret>`) with per-collection scopes. Credentials can never publish content."
  },
  "servers": [
    {
      "url": "https://cms.vantuch.dev/api"
    }
  ],
  "security": [
    {
      "botToken": []
    }
  ],
  "tags": [
    {
      "name": "Events"
    },
    {
      "name": "Articles"
    },
    {
      "name": "News"
    },
    {
      "name": "Publications"
    },
    {
      "name": "Social posts"
    },
    {
      "name": "Runs"
    }
  ],
  "paths": {
    "/ingest/v1/events": {
      "post": {
        "tags": [
          "Events"
        ],
        "operationId": "ingestEvents",
        "summary": "Upsert events (batch)",
        "description": "Idempotent upsert keyed by (collection, bot, externalId). New records start unpublished with review status Ingested. Changes to reviewed, published, or human-edited records become pending updates instead of overwriting them. Items are validated individually; see `results`.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Retry-safe request key (8–128 chars). Replays return the stored run with `Idempotent-Replayed: true`.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventIngestBatch"
              },
              "example": {
                "items": [
                  {
                    "externalId": "brno-events-agent:0f8e2a52-7d2c-4c55-9e85-3b7f1f0a9c11",
                    "title": "Example AI meetup",
                    "summary": "Ai meetup at Example venue, organised by Example organiser.",
                    "startsAt": "2026-11-20T18:00:00+01:00",
                    "endsAt": "2026-11-20T20:00:00+01:00",
                    "city": "Brno",
                    "venueName": "Example venue",
                    "category": "ai",
                    "tags": [
                      "meetup"
                    ],
                    "sourceUrl": "https://example.com/events/ai-meetup",
                    "isFree": true,
                    "freeFood": "yes",
                    "foodDetails": "Free pizza",
                    "foodEvidence": [
                      {
                        "text": "Free pizza and drinks after the talks."
                      }
                    ],
                    "sourceReferences": [
                      {
                        "title": "Example listing",
                        "url": "https://example.com/events/ai-meetup"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch processed (status succeeded or partial)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestRun"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bot credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Credential lacks the required scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency-Key conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body or batch too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Every item in the batch failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestRun"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (details are never exposed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },

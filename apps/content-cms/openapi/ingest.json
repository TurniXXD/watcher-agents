  "components": {
    "schemas": {
      "EventIngestItem": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[\\x21-\\x7e]+$",
            "description": "Stable identifier from the bot. Re-sending the same id updates the same record."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "summary": {
            "description": "Original short summary. Do not copy organiser text.",
            "type": "string",
            "maxLength": 1000
          },
          "descriptionText": {
            "description": "Original plain-text description. Stored as rich text for editors.",
            "type": "string",
            "maxLength": 5000
          },
          "sourceExcerpt": {
            "description": "Internal context for editors; never published.",
            "type": "string",
            "maxLength": 1000
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp with UTC offset",
            "example": "2026-11-20T18:00:00+01:00"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 timestamp with UTC offset",
            "example": "2026-11-20T18:00:00+01:00"
          },
          "timezone": {
            "default": "Europe/Prague",
            "type": "string"
          },
          "city": {
            "default": "Brno",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "venueName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "category": {
            "default": "other",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "tags": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "organizerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "Canonical organiser or source event page."
          },
          "registrationUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "sourceImageUrl": {
            "description": "Recorded for editors; never republished automatically.",
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "isFree": {
            "description": "Free admission. Omit or null when unknown.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "currency": {
            "example": "CZK",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "freeFood": {
            "default": "unknown",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "foodDetails": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "foodEvidence": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FoodEvidence"
            }
          },
          "eventStatus": {
            "default": "scheduled",
            "type": "string",
            "enum": [
              "scheduled",
              "cancelled",
              "postponed"
            ]
          },
          "verifiedAt": {
            "description": "When the bot last confirmed the event at its source.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "example": "2026-11-20T18:00:00+01:00"
          },
          "sourceReferences": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceReference"
            }
          },
          "aiProvenance": {
            "$ref": "#/components/schemas/AiProvenance"
          }
        },
        "required": [
          "externalId",
          "title",
          "startsAt",
          "sourceUrl"
        ]
      },

# Vantuch Content Hub (Payload CMS). Copy to apps/content-cms/.env for local development.
# Never commit real values.
NODE_ENV=development
# Dedicated CMS database (separate from the Watcher database).
DATABASE_URI=postgresql://content_cms:content_cms@localhost:5432/content_cms
DATABASE_POOL_MAX=10
# At least 32 random characters: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
# Public origin of the CMS, without a trailing slash.
SERVER_URL=http://localhost:3100
# Browser origins allowed to call the public API (comma-separated).
CORS_ORIGINS=http://localhost:3000
# Extra origins allowed to send admin cookies (comma-separated); SERVER_URL is always allowed.
CSRF_ORIGINS=
LOG_LEVEL=info
# true only behind a trusted proxy (cloudflared) that sets CF-Connecting-IP / X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# RustFS / S3-compatible media storage. Required in production; all four credentials together.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=content-cms
MEDIA_MAX_IMAGE_SIZE_MB=15
MEDIA_MAX_DOCUMENT_SIZE_MB=25
MEDIA_MAX_VIDEO_SIZE_MB=200
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
INGEST_RATE_LIMIT_PER_MINUTE=60
INGEST_MAX_BODY_BYTES=1000000
INGEST_MAX_BATCH_SIZE=100
# Optional on-demand revalidation webhook on the website (set both or neither).
REVALIDATE_WEBHOOK_URL=
REVALIDATE_WEBHOOK_SECRET=
# Optional website draft preview (set both or neither).
WEBSITE_PREVIEW_URL=
PREVIEW_SECRET=
# Run scheduled publish jobs in this process.
PAYLOAD_JOBS_AUTORUN=true
# MCP server at POST /api/mcp (per-user API keys managed in the admin under MCP). false disables the endpoint.
MCP_ENABLED=true

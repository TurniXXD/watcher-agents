{
  "name": "@watcher/briefing-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "notion:check": "tsx src/notion-journal-check.ts",
    "notion:setup": "tsx src/notion-journal-setup.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@watcher/core": "workspace:*",
    "@watcher/database": "workspace:*",
    "@watcher/llm": "workspace:*",
    "@watcher/notion": "workspace:*",
    "@watcher/observability": "workspace:*",
    "@watcher/telegram": "workspace:*",
    "grammy": "1.46.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}

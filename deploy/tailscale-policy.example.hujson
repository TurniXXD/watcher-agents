// Merge these sections into the existing tailnet policy. Do not replace rules
// required by other tailnet users or services.
{
  "tagOwners": {
    "tag:ci": ["autogroup:admin"],
    "tag:watcher-server": ["autogroup:admin"],
  },

  "grants": [
    {
      "src": ["tag:ci"],
      "dst": ["tag:watcher-server"],
      "ip": ["tcp:22"],
    },
  ],
}

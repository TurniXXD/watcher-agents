# Copy to deploy/runtime/quickly.env and keep mode 0600. Password must be URL-safe.
POSTGRES_DB=quickly
POSTGRES_USER=quickly
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://quickly:<same-url-safe-password>@quickly-postgres:5432/quickly
# Browser-facing URL. For VPN access use http://<VPN-IP>:<QUICKLY_HOST_PORT>.
BASE_URL=http://localhost:8000
QUICKLY_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
OFFICE365_TENANT_ID=common
# Must contain the same browser origin as BASE_URL (no trailing slash).
CORS_ORIGINS=http://localhost:8000

DATABASE_URL=postgresql://watcher:<url-encoded-password>@watcher-postgres:5432/watcher
SALES_TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=<comma-separated-telegram-user-ids>
SALES_API_TOKEN=
SALES_WEBHOOK_TOKEN=
SALES_PORT=4050
# Interval for the Sales pipeline and saved /sales_search subscriptions.
SALES_INTERVAL_MINUTES=30
SALES_FOLLOWUP_TIME=20:00
SALES_TIMEZONE=Europe/Prague
# Primary POI/contact enrichment; ARES discovery works without a key.
GEOAPIFY_API_KEY=
# Optional Google Places fallback. Restrict the key to Places API (New).
GOOGLE_PLACES_API_KEY=
# Optional private Network Bot. Share only the target spreadsheet with this service account.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_NETWORK_RANGE="'Contact list'!A:K"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# One line with literal \n sequences; keep the populated file mode 0600.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
NETWORK_OLLAMA_VISION_MODEL=
QUICKLY_BASE_URL=http://quickly:8000
QUICKLY_API_KEY=
TWENTY_BASE_URL=http://twenty-server:3000
TWENTY_API_KEY=
# Set true only after apps/twenty-sales-app has been applied to this workspace.
TWENTY_APP_FIELDS_ENABLED=false
# Optional structured cold-email drafts. Both values must be set together.
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=4096
OLLAMA_RETRIES=1
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=120000
LOG_LEVEL=info

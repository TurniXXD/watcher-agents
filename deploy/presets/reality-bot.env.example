DATABASE_URL=postgresql://watcher:<url-encoded-password>@postgres:5432/watcher
REALITY_TELEGRAM_TOKEN=<telegram-bot-token>
TELEGRAM_ALLOWED_USER_IDS=<comma-separated-telegram-user-ids>
# Optional pilot/account key for DigiReality RSS. Anonymous personal use is supported.
REALITY_DIGIREALITY_KEY=
REALITY_DEFAULT_LOCATIONS=Brno,Ostrava,Frýdek-Místek
REALITY_REPORT_SCHEDULE=0 8 1 * *
REALITY_MONITOR_INTERVAL_MINUTES=30
REALITY_HEALTH_PORT=4050
DEFAULT_TIMEZONE=Europe/Prague
LOG_LEVEL=info

# deploy/runtime/content-cms.env for the `content-cms` service in docker-compose.production.yml
# (mode 0600; never commit real values). Production inherits the Watcher
# DATABASE_URL from migrate.env and stores CMS tables in the same database.
DATABASE_POOL_MAX=10
PAYLOAD_SECRET=<openssl-rand-hex-32>
SERVER_URL=https://cms.vantuch.dev
CORS_ORIGINS=https://vantuch.dev,https://www.vantuch.dev
CSRF_ORIGINS=
LOG_LEVEL=info
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=content-cms
S3_ACCESS_KEY_ID=<rustfs-access-key>
S3_SECRET_ACCESS_KEY=<rustfs-secret-key>
S3_FORCE_PATH_STYLE=true
S3_PREFIX=content-cms
MEDIA_MAX_IMAGE_SIZE_MB=15
MEDIA_MAX_DOCUMENT_SIZE_MB=25
MEDIA_MAX_VIDEO_SIZE_MB=200
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
INGEST_RATE_LIMIT_PER_MINUTE=60
INGEST_MAX_BODY_BYTES=1000000
INGEST_MAX_BATCH_SIZE=100
REVALIDATE_WEBHOOK_URL=
REVALIDATE_WEBHOOK_SECRET=
WEBSITE_PREVIEW_URL=
PREVIEW_SECRET=
PAYLOAD_JOBS_AUTORUN=true

DATABASE_URL=postgresql://watcher:<url-encoded-password>@postgres:5432/watcher
STOCKS_TELEGRAM_TOKEN=<telegram-bot-token>
TELEGRAM_ALLOWED_USER_IDS=<comma-separated-telegram-user-ids>
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_ITEMS_PER_RUN=0
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_FULL_ANALYSIS_NUM_PREDICT=1536
OLLAMA_RETRIES=1
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=120000
STOCK_EVENT_COOLDOWN_MINUTES=360
STOCK_TICKER_ANALYSIS_COOLDOWN_MINUTES=30
SOURCE_BACKOFF_BASE_SECONDS=60
SOURCE_BACKOFF_MAX_MINUTES=360
ALERT_ATTENTION_THRESHOLD=85
RECONCILIATION_INTERVAL_MINUTES=1440
VALIDATION_MIN_SAMPLE_SIZE=20
SEC_USER_AGENT=Watcher/1.0 admin@example.com
DEFAULT_TIMEZONE=Europe/Prague
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_OPTIONS_ENABLED=false
QUIVER_API_TOKEN=
PRICE_ANOMALY_THRESHOLD_PERCENT=4
GAP_ANOMALY_THRESHOLD_PERCENT=3
RELATIVE_VOLUME_ANOMALY_THRESHOLD=3
VOLATILITY_EXPANSION_THRESHOLD=2
MARKET_BASELINE_MIN_SNAPSHOTS=5
OPTIONS_VOLUME_OI_ANOMALY_THRESHOLD=2
OPTIONS_VOLUME_BASELINE_MULTIPLIER=3
OPTIONS_BASELINE_MIN_SNAPSHOTS=3
INSTITUTIONAL_CHANGE_THRESHOLD_PERCENT=5
SHORT_INTEREST_CHANGE_THRESHOLD_PERCENT=10
SHORT_INTEREST_DAYS_TO_COVER_THRESHOLD=5
DISCOVERY_MARKET_DATA_ENTITLEMENT=EOD
DISCOVERY_SCAN_INTERVAL_MINUTES=1440
DISCOVERY_MOVE_THRESHOLD_PERCENT=4
DISCOVERY_MIN_PRICE=2
DISCOVERY_MIN_VOLUME=100000
DISCOVERY_MIN_DOLLAR_VOLUME=1000000
DISCOVERY_MAX_CANDIDATES=10
DISCOVERY_SUPPORTED_EXCHANGES=Nasdaq,NYSE,NYSE American
DISCOVERY_EXCLUDE_OTC=true
DISCOVERY_INVESTIGATION_MINUTES=90
DISCOVERY_HIGH_RESOLUTION_INTERVAL_MINUTES=5
DISCOVERY_EVENT_MODE_MINUTES=120
DISCOVERY_WATCH_DAYS=14

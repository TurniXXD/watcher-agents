# Copy to deploy/runtime/twenty.env and keep mode 0600. Password must be URL-safe.
POSTGRES_DB=twenty
POSTGRES_USER=twenty
POSTGRES_PASSWORD=
PG_DATABASE_URL=postgres://twenty:<same-url-safe-password>@twenty-postgres:5432/twenty
REDIS_URL=redis://twenty-redis:6379
# Browser-facing URL; replace with the Cloudflare-protected production origin.
SERVER_URL=https://crm.example.com
NODE_PORT=3000
STORAGE_TYPE=local
ENCRYPTION_KEY=
IS_MULTIWORKSPACE_ENABLED=false
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true

DATABASE_URL=postgresql://watcher:<url-encoded-password>@watcher-postgres:5432/watcher
NETWORKING_TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=<comma-separated-telegram-user-ids>
NETWORKING_TIMEZONE=Europe/Prague
NETWORKING_SCHEDULER_INTERVAL_MS=30000
NETWORKING_HEALTH_PORT=4070
NETWORKING_GOOGLE_CALENDAR_CLIENT_ID=
NETWORKING_GOOGLE_CALENDAR_CLIENT_SECRET=
# Example: https://api.example.com/networking-bot/oauth/google/callback
NETWORKING_GOOGLE_CALENDAR_REDIRECT_URI=
# Generate with: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=
NETWORKING_CALENDAR_OAUTH_LISTEN_HOST=0.0.0.0
NETWORKING_CALENDAR_OAUTH_LISTEN_PORT=8790
# Share only the existing Contact list sheet with this service account.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_NETWORK_RANGE="'Contact list'!A:K"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the populated value on one line with literal \n sequences.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
# Must be an installed Ollama model with image input support.
NETWORK_OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_MS=120000
LOG_LEVEL=info

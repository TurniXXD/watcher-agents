DATABASE_URL=postgresql://watcher:<url-encoded-password>@postgres:5432/watcher
BRIEFING_TELEGRAM_TOKEN=<telegram-bot-token>
TELEGRAM_ALLOWED_USER_IDS=<comma-separated-telegram-user-ids>
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
BRIEFING_EMBEDDING_MODEL=nomic-embed-text
BRIEFING_EMBEDDING_MIN_SIMILARITY=0.82
BRIEFING_EMBEDDING_WINDOW_HOURS=96
OLLAMA_KEEP_ALIVE=5m
# Rendered from BRIEFING_OLLAMA_NUM_CTX; this service-local name is what the app reads.
OLLAMA_NUM_CTX=8192
OLLAMA_RETRIES=1
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=300000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Example: https://api.example.com/briefing-bot/oauth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_OAUTH_LISTEN_HOST=0.0.0.0
CALENDAR_OAUTH_LISTEN_PORT=8789
PIPER_DATA_DIR=/data/piper
PIPER_PYTHON_PATH=python3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PIPER_KEEP_TEMP=false
BRIEFING_TTS_ATTEMPTS=2
BRIEFING_TELEGRAM_ATTEMPTS=3
BRIEFING_TELEGRAM_RETRY_BASE_MS=1000
BRIEFING_SCHEDULER_INTERVAL_MS=30000
BRIEFING_FRESHNESS_MAX_AGE_MINUTES=180
BRIEFING_FRESHNESS_WAIT_TIMEOUT_MINUTES=20
BRIEFING_FRESHNESS_POLL_INTERVAL_MS=30000
DEFAULT_TIMEZONE=Europe/Prague
LOG_LEVEL=info

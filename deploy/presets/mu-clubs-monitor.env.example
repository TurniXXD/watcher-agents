DATABASE_URL=postgresql://watcher:<url-encoded-password>@postgres:5432/watcher
MU_CLUBS_API_TOKEN=<long-random-bearer-token>
MU_CLUBS_HOST=0.0.0.0
MU_CLUBS_PORT=4010
MU_CLUBS_MONITOR_INTERVAL_MINUTES=60
MU_CLUBS_SCHEDULER_INTERVAL_MS=30000
INSTAGRAM_CACHE_TTL_MINUTES=30
INSTAGRAM_MIN_REQUEST_INTERVAL_MS=5000
INSTAGRAM_MAX_POSTS_PER_FETCH=20
LOG_LEVEL=info

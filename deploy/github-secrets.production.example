# VPS transport over the Tailscale network
DEPLOY_HOST=watcher-vps.tailnet-name.ts.net
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=<multiline-private-key>
DEPLOY_KNOWN_HOSTS=<verified-known-hosts-line>
DEPLOY_PORT=22

# GHCR access for server-side image pulls
GHCR_USERNAME=<github-user-or-organization>
GHCR_TOKEN=<fine-grained-token-with-packages-read>

# Tailscale GitHub Actions access
TS_OAUTH_CLIENT_ID=<tailscale-oauth-client-id>
TS_OAUTH_SECRET=<tailscale-oauth-secret>


# Non-sensitive values for the GitHub environment named "production".
# Add these under Settings > Environments > production > Environment variables.

DEPLOY_PATH=/opt/watcher
DEPLOY_ENV_FILE=/opt/watcher/deploy/runtime/compose.env
TS_TAG=tag:ci
# Trivy rechecks unchanged lockfiles/image digests after this interval.
SECURITY_SCAN_MIN_INTERVAL_MINUTES=360

